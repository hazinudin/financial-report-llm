# Copy to .env (gitignored) and fill in. Never commit real keys.
#
# Model provider — Command Code Provider API (config.yaml analysis.llm).
# Create the key in the Command Code dashboard; a "Provider" plan (or BYOK) is
# required for API access. Used by every stage:
#   - extract / redflags: read directly by opencode_client via api_key_env
#   - plan / research / write / chat: inherited by the headless `pi` subprocess,
#     where the pi-commandcode-provider extension picks it up (so a server needs
#     no `pi` /login and no ~/.pi/agent/auth.json)
# Locally, if this is unset, the client falls back to an existing login in
# ~/.pi/agent/auth.json.
COMMAND_CODE_API_KEY=user_xxx

# Stage 3b (external research) web discovery, from exa.ai.
EXA_API_KEY=
